#include <physical_layouts.dtsi>

/ {
    charybdis_4x6_layout: charybdis_4x6_layout {
        compatible = "zmk,physical-layout";
        display-name = "Charybdis 4x6";
        transform = <&default_transform>;
        kscan = <&kscan0>;

        //                        w   h     x     y   rot    rx    ry
        keys = // Left row 0
               <&key_physical_attrs 100 100     0     0     0     0     0>
             , <&key_physical_attrs 100 100   100    10     0     0     0>
             , <&key_physical_attrs 100 100   200    20     0     0     0>
             , <&key_physical_attrs 100 100   300    20     0     0     0>
             , <&key_physical_attrs 100 100   400    10     0     0     0>
             , <&key_physical_attrs 100 100   500     0     0     0     0>
               // Right row 0
             , <&key_physical_attrs 100 100   700     0     0     0     0>
             , <&key_physical_attrs 100 100   800    10     0     0     0>
             , <&key_physical_attrs 100 100   900    20     0     0     0>
             , <&key_physical_attrs 100 100  1000    20     0     0     0>
             , <&key_physical_attrs 100 100  1100    10     0     0     0>
             , <&key_physical_attrs 100 100  1200     0     0     0     0>
               // Left row 1
             , <&key_physical_attrs 100 100     0   100     0     0     0>
             , <&key_physical_attrs 100 100   100   110     0     0     0>
             , <&key_physical_attrs 100 100   200   120     0     0     0>
             , <&key_physical_attrs 100 100   300   120     0     0     0>
             , <&key_physical_attrs 100 100   400   110     0     0     0>
             , <&key_physical_attrs 100 100   500   100     0     0     0>
               // Right row 1
             , <&key_physical_attrs 100 100   700   100     0     0     0>
             , <&key_physical_attrs 100 100   800   110     0     0     0>
             , <&key_physical_attrs 100 100   900   120     0     0     0>
             , <&key_physical_attrs 100 100  1000   120     0     0     0>
             , <&key_physical_attrs 100 100  1100   110     0     0     0>
             , <&key_physical_attrs 100 100  1200   100     0     0     0>
               // Left row 2
             , <&key_physical_attrs 100 100     0   200     0     0     0>
             , <&key_physical_attrs 100 100   100   210     0     0     0>
             , <&key_physical_attrs 100 100   200   220     0     0     0>
             , <&key_physical_attrs 100 100   300   220     0     0     0>
             , <&key_physical_attrs 100 100   400   210     0     0     0>
             , <&key_physical_attrs 100 100   500   200     0     0     0>
               // Right row 2
             , <&key_physical_attrs 100 100   700   200     0     0     0>
             , <&key_physical_attrs 100 100   800   210     0     0     0>
             , <&key_physical_attrs 100 100   900   220     0     0     0>
             , <&key_physical_attrs 100 100  1000   220     0     0     0>
             , <&key_physical_attrs 100 100  1100   210     0     0     0>
             , <&key_physical_attrs 100 100  1200   200     0     0     0>
               // Left row 3
             , <&key_physical_attrs 100 100     0   300     0     0     0>
             , <&key_physical_attrs 100 100   100   310     0     0     0>
             , <&key_physical_attrs 100 100   200   320     0     0     0>
             , <&key_physical_attrs 100 100   300   320     0     0     0>
             , <&key_physical_attrs 100 100   400   310     0     0     0>
             , <&key_physical_attrs 100 100   500   300     0     0     0>
               // Right row 3
             , <&key_physical_attrs 100 100   700   300     0     0     0>
             , <&key_physical_attrs 100 100   800   310     0     0     0>
             , <&key_physical_attrs 100 100   900   320     0     0     0>
             , <&key_physical_attrs 100 100  1000   320     0     0     0>
             , <&key_physical_attrs 100 100  1100   310     0     0     0>
             , <&key_physical_attrs 100 100  1200   300     0     0     0>
               // Left thumb cluster (3 keys)
             , <&key_physical_attrs 100 100   200   420     0     0     0>
             , <&key_physical_attrs 100 100   300   430     0     0     0>
             , <&key_physical_attrs 100 100   400   420     0     0     0>
               // Right thumb cluster (3 keys)
             , <&key_physical_attrs 100 100   800   420     0     0     0>
             , <&key_physical_attrs 100 100   900   430     0     0     0>
             , <&key_physical_attrs 100 100  1000   420     0     0     0>
               ;
    };
};
